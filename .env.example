# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies and JWT tokens.
SESSION_SECRET="your_strong_random_session_secret_here"

# TURSO_DATABASE_URL: Connection URL for hosted Turso SQLite database (e.g. libsql://your-db-org.turso.io)
TURSO_DATABASE_URL="libsql://your-db-name-org.turso.io"

# TURSO_AUTH_TOKEN: Authentication token generated for Turso database access
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# ADMIN_EMAIL: Initial administrator email used for database seeding.
ADMIN_EMAIL="admin@megamarket.co.ke"

# ADMIN_PASSWORD: Initial administrator password used for database seeding (min 8 characters).
ADMIN_PASSWORD="AdminPassword2026!"

# BREVO_API_KEY: Brevo transactional email API key for sending verification codes.
BREVO_API_KEY="your_brevo_api_key_here"

# MAIL_FROM_EMAIL: Verified sender email address configured in Brevo.
MAIL_FROM_EMAIL="no-reply@yourdomain.com"

# MAIL_FROM_NAME: Sender display name shown on transactional emails.
MAIL_FROM_NAME="MegaMarket"

# MAIL_DEBUG: Set to "true" in non-production environments to print verification codes to server logs for testing.
MAIL_DEBUG="false"
